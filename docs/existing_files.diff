+:root{--ink:#172b4d;--muted:#778399;--blue:#3468ea;}
+html,body,[class*="css"]{font-family:"Microsoft YaHei","Noto Sans SC",sans-serif;}
+.stApp{background:#f7f9fd;color:var(--ink);}
+.block-container{padding:3.5rem 2rem 3rem;max-width:1480px;}
+h1{font-size:2.05rem!important;font-weight:700!important;letter-spacing:-.045em;}
+h2{font-size:1.35rem!important;}h3{font-size:1.1rem!important;}
+.page-subtitle{color:#75829b;margin-top:-.4rem;margin-bottom:1.65rem;line-height:1.7;}
+[data-testid="stSidebar"]{background:white;border-right:1px solid #e7ecf5;}
+[data-testid="stSidebarNav"]{display:none;}
+[data-testid="stSidebar"]{min-width:260px!important;max-width:280px!important;}
+.brand-icon{display:inline-flex;align-items:center;justify-content:center;background:#3468ea;color:white;width:42px;height:42px;border-radius:12px;font-size:29px;margin-right:10px;vertical-align:middle;}
+.brand-name{display:inline-block;font-size:20px;font-weight:700;vertical-align:middle;color:#173157;}
+.brand-name span{display:block;font-size:9px;letter-spacing:2px;color:#8a96aa;margin-top:3px;}
+[data-testid="stMetric"]{background:white;border:1px solid #e6ecf5;border-radius:13px;padding:18px 20px;box-shadow:0 3px 10px #17315703;}
+[data-testid="stMetricLabel"]{color:#7a879c;font-size:13px;}
+[data-testid="stMetricValue"]{font-size:1.9rem;font-weight:650;color:#234c95;}
+[data-testid="stForm"]{background:white;border:1px solid #e5ebf4;border-radius:14px;}
+[data-testid="stVerticalBlockBorderWrapper"]>div{border-color:#e6ecf5!important;border-radius:14px!important;}
+.hero{background:linear-gradient(120deg,#123c83,#396fe0);border-radius:18px;color:white;padding:30px 34px;margin:6px 0 26px;position:relative;overflow:hidden;}
+.hero:after{content:"◈";position:absolute;right:35px;top:-12px;font-size:160px;color:#ffffff13;}
+.hero small{font-size:11px;letter-spacing:2px;color:#b5cffc;}
+.hero h2{color:white!important;font-size:1.65rem!important;margin:10px 0 8px;}
+.hero p{color:#d7e6ff;font-size:14px;max-width:710px;line-height:1.8;margin:0;}
+.flow-step{padding:18px 14px;background:white;border:1px solid #e5ebf4;border-radius:12px;min-height:105px;}
+.flow-step span{font-size:11px;color:#8b9ab4;letter-spacing:1px;}.flow-step b{display:block;margin:5px 0;color:#244875;font-size:15px;}.flow-step p{color:#8a96aa;font-size:12px;margin:0;}
+.stButton>button[kind="primary"],.stFormSubmitButton>button[kind="primary"]{background:#3468ea;border:0;border-radius:9px;}
+[data-baseweb="tab-list"]{gap:14px;border-bottom:1px solid #e8edf6;margin-bottom:16px;}
+footer{visibility:hidden;}
+@media(max-width:1100px){
+ .block-container{padding-left:1.2rem;padding-right:1.2rem;}
+ [data-testid="stHorizontalBlock"]{flex-wrap:wrap;gap:1rem;}
+ [data-testid="stHorizontalBlock"]>[data-testid="stColumn"]{width:calc(50% - .5rem)!important;flex:1 1 calc(50% - .5rem)!important;min-width:0!important;}
+ [data-testid="stMetric"]{padding:12px 10px;}
+ [data-testid="stMetricValue"]{font-size:1.4rem;}
+ .hero{padding:24px;}
 }
